---
const slides = [
  {
    eyebrow: 'Strony internetowe Kraków',
    title: 'Nowoczesne strony firmowe, które zwiększają sprzedaż',
    description:
      'Tworzymy witryny dopasowane do lokalnego rynku, które budują zaufanie, poprawiają konwersję i pomagają firmom w Krakowie zdobywać nowych klientów.',
    points: ['SEO', 'UX/UI', 'Responsywność', 'Współpraca pod klucz'],
    metric: 'Od 1499 zł',
  },
  {
    eyebrow: 'Sklepy internetowe Kraków',
    title: 'E-commerce pod klucz do skutecznej sprzedaży online',
    description:
      'Sklepy internetowe Kraków od Fachowe Strony łączą estetykę, szybkie ładowanie i wygodny proces zakupowy, dzięki czemu Twoi klienci kupują szybciej i częściej.',
    points: ['Shopify / WooCommerce', 'Koszyk', 'Płatności', 'Optymalizacja'],
    metric: 'Od 2999 zł',
  },
  {
    eyebrow: 'Pozycjonowanie i marketing',
    title: 'Strony internetowe i sklepy, które są widoczne w Google',
    description:
      'Dla firm działających w Krakowie projektujemy witryny z myślą o SEO, konwersji i zasięgu, dzięki czemu lepiej wypadają w wynikach wyszukiwania i przyciągają klientów.',
    points: ['Google Business', 'SEO on-page', 'Content strategy', 'Wizerunek marki'],
    metric: 'Lokalne SEO',
  },
  {
    eyebrow: 'Dla firm i startupów',
    title: 'Rozwiązania webowe, które wspierają rozwój biznesu',
    description:
      'Niezależnie od tego, czy potrzebujesz strony internetowej w Krakowie, landing page czy sklepu internetowego, projektujemy rozwiązania, które wspierają sprzedaż i budują przewagę konkurencyjną.',
    points: ['Landing page', 'Aplikacje web', 'Obsługa i rozwój', 'Wsparcie'],
    metric: 'Szybki start',
  },
];

const repeatedSlides = [...slides, ...slides];
---

<section class='info-slider not-prose' aria-label='Sekcja usług i rozwiązań marketingowych'>
  <div class='mx-auto max-w-7xl px-4 sm:px-6'>
    <div class='info-slider__viewport'>
      <div class='info-slider__track'>
        {
          repeatedSlides.map((slide, index) => (
            <article class='info-slider__slide' data-key={`${slide.eyebrow}-${index}`}>
              <div class='info-slider__content'>
                <p class='info-slider__eyebrow'>{slide.eyebrow}</p>
                <h3>{slide.title}</h3>
                <p class='info-slider__description'>{slide.description}</p>
                <ul class='info-slider__points'>
                  {slide.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
              <div class='info-slider__meta'>
                <span>{slide.metric}</span>
                <a href='/oferta'>Zobacz ofertę</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
