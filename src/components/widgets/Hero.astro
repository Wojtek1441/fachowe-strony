---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<section class='relative md:-mt-[76px] not-prose' {...id ? { id } : {}}>
  <div class='absolute inset-0 pointer-events-none' aria-hidden='true'>
    <slot name='bg'>
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>
  <div class='relative max-w-7xl mx-auto px-4 sm:px-6'>
    <div class='pt-0 md:pt-[76px] pointer-events-none'></div>
    <div class='pt-8 md:pt-12'>
      <div class='overflow-hidden'>
        <div class='grid items-center gap-10 px-0 py-10 md:px-2 md:py-14 lg:grid-cols-[1.1fr_0.9fr] lg:px-4 lg:py-20'>
          <div class='text-left'>
            {
              tagline && (
                <p
                  class='mb-5 text-sm font-bold uppercase tracking-[0.22em] text-violet-300 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
                  set:html={tagline}
                />
              )
            }
            {
              title && (
                <h1
                  class='mb-6 max-w-3xl text-[2.8rem] font-bold leading-[0.9] tracking-[-0.06em] text-white md:text-[4rem] lg:text-[4.4rem] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
                  set:html={title}
                />
              )
            }
            <div class='max-w-xl'>
              {
                subtitle && (
                  <p
                    class='mb-8 text-lg leading-relaxed text-slate-300 md:text-xl intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
                    set:html={subtitle}
                  />
                )
              }
              {
                actions && (
                  <div class='flex max-w-md flex-col gap-4 sm:flex-row sm:justify-start intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'>
                    {Array.isArray(actions) ? (
                      actions.map((action) => (
                        <div class='flex w-full sm:w-auto'>
                          <Button {...(action || {})} class='w-full sm:mb-0' />
                        </div>
                      ))
                    ) : (
                      <Fragment set:html={actions} />
                    )}
                  </div>
                )
              }
            </div>
            {content && <Fragment set:html={content} />}
          </div>

          <div class='relative hidden lg:block'>
            <div class='hero-visual relative mx-auto h-[420px] w-full max-w-[460px]'>
              <div class='hero-visual__orb hero-visual__orb--violet'></div>
              <div class='hero-visual__orb hero-visual__orb--blue'></div>

              <div class='hero-visual__badge'>+120% ROI</div>

              <svg class='hero-visual__figure' viewBox='0 0 360 340' aria-hidden='true'>
                <defs>
                  <linearGradient id='hero-person-suit' x1='0%' x2='100%' y1='0%' y2='100%'>
                    <stop offset='0%' stop-color='#a78bfa' stop-opacity='0.98' />
                    <stop offset='55%' stop-color='#7dd3fc' stop-opacity='0.9' />
                    <stop offset='100%' stop-color='#d8b4fe' stop-opacity='0.82' />
                  </linearGradient>
                  <linearGradient id='hero-person-skin' x1='0%' x2='100%' y1='0%' y2='100%'>
                    <stop offset='0%' stop-color='#f8d9c8' />
                    <stop offset='100%' stop-color='#f2b79d' />
                  </linearGradient>
                </defs>

                <g>
                  <circle cx='180' cy='72' r='38' fill='url(#hero-person-skin)' opacity='0.96' />
                  <path d='M145 88c9-18 60-19 71 0l-8 18c-5 11-13 17-27 17s-22-7-27-17l-9-18Z' fill='#0f172a' opacity='0.82' />

                  <path d='M122 130c18-18 45-28 58-28 25 0 52 15 66 38l10 138H110L122 130Z' fill='url(#hero-person-suit)' opacity='0.92' />

                  <path d='M180 160l-18 58 25 35 35-28 14-53-56-12Z' fill='rgba(15,23,42,0.35)' />

                  <path d='M188 166c17 0 27 10 32 25l12 51-32 27-36-35 6-49c3-14 12-19 18-19Z' fill='url(#hero-person-suit)' opacity='0.96' />

                  <path d='M118 180c-26 12-47 38-48 65 0 16 9 30 22 38 14 8 25 3 33-11l18-48-25-44Z' fill='url(#hero-person-suit)' opacity='0.88' />

                  <path d='M214 178c30 10 44 31 48 57 2 13-2 24-16 33-16 11-34 9-44-10l-17-44 29-36Z' fill='url(#hero-person-suit)' opacity='0.88' />

                  <path d='M205 168l44-56c10-13 12-29 6-42-7-17-29-24-45-13l-48 35 43 76Z' fill='url(#hero-person-suit)' opacity='0.9' />
                  <path d='M197 126c12 8 26 8 38 2l18 31-8 15-35-18-19-30Z' fill='rgba(15,23,42,0.25)' />

                  <path d='M156 147l-33 17c-21 12-34 34-34 58 0 8 7 15 15 15h15c13 0 24-9 28-21l13-46 14-23Z' fill='rgba(148,163,184,0.18)' />

                  <path d='M244 117l18-35 34 9-12 37-40-11Z' fill='url(#hero-person-suit)' opacity='0.9' />

                  <path d='M262 88l40 15 11 20-6 31-27 13-21-18 3-32-18-29 18 0Z' fill='rgba(14,165,233,0.18)' />

                  <path d='M255 152l20 11 31 8 8 18-17 13-31-8-31-25 20-17Z' fill='rgba(255,255,255,0.16)' />
                  <path d='M278 166l17 10 15 17-8 13-20-10-10-14 6-16Z' fill='#a78bfa' opacity='0.9' />
                  <path d='M300 186l22 9 18 18-15 10-23-8-12-15 10-14Z' fill='#7dd3fc' opacity='0.9' />
                </g>
              </svg>
            </div>
          </div>
        </div>
      </div>

      <div
        class='intersect-once intercept-no-queue intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'>
        {
          image && (
            <div class='relative m-auto max-w-5xl'>
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class='mx-auto rounded-md w-full'
                  widths={[400, 768, 1024, 2040]}
                  sizes='(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px'
                  loading='eager'
                  width={1024}
                  height={576}
                  {...image}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
