---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import heroImage from '~/assets/images/hero-visual.webp';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<section class='relative md:-mt-[76px] not-prose' {...id ? { id } : {}}>
  <div class='absolute inset-0 pointer-events-none' aria-hidden='true'>
    <slot name='bg'>
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>
  <div class='relative max-w-7xl mx-auto px-4 sm:px-6'>
    <div class='pt-0 md:pt-[76px] pointer-events-none'></div>
    <div class='pt-8 md:pt-12'>
      <div class='overflow-hidden'>
        <div class='grid items-center gap-10 px-0 py-10 md:px-2 md:py-14 lg:grid-cols-[1.1fr_0.9fr] lg:px-4 lg:py-20'>
          <div class='text-left'>
            {
              tagline && (
                <p
                  class='mb-5 text-sm font-bold uppercase tracking-[0.22em] text-violet-300 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
                  set:html={tagline}
                />
              )
            }
            {
              title && (
                <h1
                  class='mb-6 max-w-3xl text-[2.8rem] font-bold leading-[0.9] tracking-[-0.06em] text-white md:text-[4rem] lg:text-[4.4rem] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
                  set:html={title}
                />
              )
            }
            <div class='max-w-xl'>
              {
                subtitle && (
                  <p
                    class='mb-8 text-lg leading-relaxed text-slate-300 md:text-xl intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
                    set:html={subtitle}
                  />
                )
              }
              {
                actions && (
                  <div class='flex max-w-md flex-col gap-4 sm:flex-row sm:justify-start intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'>
                    {Array.isArray(actions) ? (
                      actions.map((action) => (
                        <div class='flex w-full sm:w-auto'>
                          <Button {...(action || {})} class='w-full sm:mb-0' />
                        </div>
                      ))
                    ) : (
                      <Fragment set:html={actions} />
                    )}
                  </div>
                )
              }
            </div>
            {content && <Fragment set:html={content} />}
          </div>

          <div class='relative hidden lg:block'>
            <div class='hero-visual relative mx-auto w-full rounded-[30px]'>
              <div class='hero-visual__orb hero-visual__orb--violet'></div>
              <div class='hero-visual__orb hero-visual__orb--blue'></div>
              <img
                src={heroImage.src}
                alt='Wizualizacja hero dla marki usługowej i produktowej'
                class='relative z-10 h-full w-full object-contain object-center opacity-95'
              />
            </div>
          </div>
        </div>
      </div>

      <div
        class='intersect-once intercept-no-queue intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'>
        {
          image && (
            <div class='relative m-auto max-w-5xl'>
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class='mx-auto rounded-md w-full'
                  widths={[400, 768, 1024, 2040]}
                  sizes='(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px'
                  loading='eager'
                  width={1024}
                  height={576}
                  {...image}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
