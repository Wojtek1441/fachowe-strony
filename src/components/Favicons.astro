---
import favIconSvg from '~/assets/favicons/favicon.svg';
import freeLandingFavicon from '~/assets/favicons/favicon-free-landing.svg';
import appleTouchIcon from '~/assets/favicons/apple-touch-icon.png';

const isFreeLanding = Astro.url.pathname.replace(/\/+$/, '') === '/darmowa-strona';
const favicon = isFreeLanding ? freeLandingFavicon : favIconSvg;
const maskColor = isFreeLanding ? '#176f50' : '#6d28d9';
---

<link rel='shortcut icon' href={favicon.src} />
<link rel='icon' type='image/svg+xml' href={favicon.src} />
<link rel='mask-icon' href={favicon.src} color={maskColor} />
<link rel='icon' type='image/png' sizes='180x180' href={appleTouchIcon.src} />
<link rel='apple-touch-icon' sizes='180x180' href={appleTouchIcon.src} />
